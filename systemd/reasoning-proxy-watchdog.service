[Unit]
Description=OpenCode Proxy Watchdog - auto-restart if proxies die
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/opencode-thinking-fix/watchdog/watchdog.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# user scope: default.target
[Install]
WantedBy=default.target
